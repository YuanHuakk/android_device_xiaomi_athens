soong_namespace {
}

android_app_import {
    name: "TipsPrebuilt",
    apk: "tips/TipsPrebuilt.apk",
    product_specific: true,
    privileged: true,
    presigned: true,
    preprocessed: true,
    dex_preopt: {
        enabled: false,
    },
}

android_app_import {
    name: "MiuiCameraAthens",
    apk: "camera/MiuiCamera.apk",
    filename: "MiuiCamera.apk",
    system_ext_specific: true,
    // Keep the locally signed APK unchanged.
    preprocessed: true,
    // HyperOS libraries are optional and absent from AOSP.
    enforce_uses_libs: false,
    dex_preopt: {
        enabled: false,
    },
}

install_symlink {
    name: "fingerprint.goodix_us2.default_symlink",
    device_specific: true,
    installed_location: "lib64/hw/fingerprint.goodix_us2.default.so",
    symlink_target: "fingerprint.goodix_us2.so",
}

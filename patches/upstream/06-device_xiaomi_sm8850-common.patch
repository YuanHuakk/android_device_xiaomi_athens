+++ b/BoardConfigCommon.mk
@@ -146,7 +146,11 @@ VENDOR_SECURITY_PATCH := $(BOOT_SECURITY_PATCH)
 
 # Verified Boot
 BOARD_AVB_ENABLE := true
-BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
+# Keep AVB chain traversal: the bootloader reads OS/SPL properties from the
+# chained boot/vbmeta_system images when the GKI v4 OS version field is zero.
+# Disable hashtree enforcement only; verification-disabled (bit 1) skips those
+# descriptors and makes athens ABL reject the image before entering the kernel.
+BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 1
 BOARD_MOVE_GSI_AVB_KEYS_TO_VENDOR_BOOT := true
 
 BOARD_AVB_BOOT_KEY_PATH := external/avb/test/data/testkey_rsa4096.pem

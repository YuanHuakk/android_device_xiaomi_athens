--- /dev/null
+++ b/Android.bp
@@ -0,0 +1,19 @@
+// athens: `qti_ipa_kernel_headers` inherits `generated_kernel_header_defaults`, whose
+// generator runs `make headers_install` against an in-tree kernel source tree. athens
+// ships a *prebuilt* kernel, so that generator produces nothing (its gen/ dir holds only
+// .dummy_dep) and the IPA uapi headers are missing for libipanat and ipacm -- both of
+// which do `#include <linux/msm_ipa.h>`.
+//
+// The identical headers are already carried in this repo under
+// drivers/platform/msm/include/uapi, so export that directory directly. The original
+// qti_ipa_kernel_headers entry is left in place so the modules still resolve correctly
+// on trees that do build the kernel from source.
+
+cc_library_headers {
+    name: "qti_ipa_uapi_headers",
+
+    export_include_dirs: ["drivers/platform/msm/include/uapi"],
+
+    vendor_available: true,
+    recovery_available: true,
+}

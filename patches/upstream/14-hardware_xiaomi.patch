+// SPDX-License-Identifier: Apache-2.0
+package vendor.xiaomi.hardware.mlipay;
+
+// Client subset of the stock service; IDs correspond to Binder transactions 1 and 6.
+interface IMlipayService {
+    int[] ifaa_get_idlist(int authType) = 0;
+    byte[] invoke_command(in byte[] buffer, int length) = 5;
+}

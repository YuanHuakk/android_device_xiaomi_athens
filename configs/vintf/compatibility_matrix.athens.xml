<!-- Instances declared in the stock ODM vendor.xiaomi.hardware.miauthsecretd.xml. -->
<compatibility-matrix version="7.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.miauthsecretd</name>
        <version>1</version>
        <interface>
            <name>ICpaceService</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IMIAuthSecret</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.xiaomi.hardware.oldcredential</name>
        <version>1</version>
        <interface>
            <name>IOldCredentialService</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
